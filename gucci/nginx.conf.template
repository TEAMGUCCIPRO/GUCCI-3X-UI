# Run nginx as root inside the container so privileged ports (1) and Railway's
# injected port can be bound without extra capabilities.
user root;
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 4096; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65;
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_comp_level 5;
  gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
  client_max_body_size 100m;

  proxy_temp_path /tmp/nginx-proxy;
  fastcgi_temp_path /tmp/nginx-proxy;
  uwsgi_temp_path /tmp/nginx-proxy;
  scgi_temp_path /tmp/nginx-proxy;
  client_body_temp_path /tmp/nginx-client;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  server {
    listen 1 default_server;
    listen [::]:1 default_server;
    __EXTRA_LISTEN__
    server_tokens off;
    absolute_redirect off;
    include /app/gucci/security-headers.conf;

    location = /healthz {
      access_log off;
      default_type text/plain;
      root /tmp;
      try_files /gucci-health-ok =503;
    }

    location = /favicon.ico {
      alias /app/gucci/landing/assets/favicon.svg;
      default_type image/svg+xml;
      access_log off;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      include /app/gucci/security-headers.conf;
    }

    location /gucci-assets/ {
      alias /app/gucci/landing/assets/;
      access_log off;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      include /app/gucci/security-headers.conf;
      try_files $uri =404;
    }

    # Optional Landing Page
    location = /landing {
      root /app/gucci/landing;
      try_files /index.html =404;
      add_header Cache-Control 'no-store, max-age=0';
      include /app/gucci/security-headers.conf;
    }

    # Compatibility transport for Xray WS
    location /gucci-connect/ws {
      proxy_pass http://127.0.0.1:1235;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_read_timeout 86400s;
      proxy_send_timeout 86400s;
      proxy_connect_timeout 5s;
      proxy_buffering off;
    }

    # Preserve native 3X-UI subscription routes
    location ~ ^/(sub|json|clash)/ {
      proxy_pass http://127.0.0.1:2096;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_buffering off;
      proxy_hide_header Cache-Control;
      proxy_hide_header Expires;
      add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
      add_header Expires "0" always;
    }

    # Map /gucci/panel and /gucci/panel/ to 3X-UI /panel
    location = /gucci/panel {
      return 302 /panel/;
    }

    location ~ ^/gucci/panel(?<subpath>/.*)?$ {
      proxy_pass http://127.0.0.1:2053/panel$subpath;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    # Redirect shortcuts /gucci, /gucci/, /gucci/enter
    location = /gucci/enter {
      return 302 /;
    }

    location = /gucci {
      return 302 /;
    }

    location = /gucci/ {
      return 302 /;
    }

    location ~ ^/gucci(?<subpath>/.*)?$ {
      proxy_pass http://127.0.0.1:2053$subpath;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    # Direct 3X-UI Panel proxy for root and all other paths
    location / {
      proxy_pass http://127.0.0.1:2053;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }
  }
}
