# GUCCI Railway production image.
#
# Built ON TOP of the official 3x-ui image so every Railway build automatically
# pulls the newest stable panel release. Because `:latest` is re-resolved at
# build time, redeploying always brings the latest upstream version with zero
# manual version edits. The GUCCI branding/gateway pieces are layered on top
# without overwriting the upstream binary or its database.
FROM ghcr.io/mhsanaei/3x-ui:latest

USER root
ENV TZ=Asia/Tehran

# ── Extra packages the GUCCI gateway needs on top of the base image ──────────
# nginx       = reverse proxy / landing gate in front of the panel
# sqlite3     = one-time DB normalisations performed by the entrypoint
# netcat      = used by the health watchdog
# The official 3x-ui image is Alpine-based and already ships ca-certificates,
# tzdata, fail2ban, bash, curl and openssl, so we only add what is missing.
RUN apk add --no-cache nginx sqlite netcat-openbsd \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone \
    && mkdir -p /tmp/nginx-proxy /tmp/nginx-client /run/nginx /var/log/nginx /var/log

# ── GUCCI layer: landing page, nginx gateway, entrypoint, health watchdog ────
# The official image already provides /app/x-ui and /app/DockerEntrypoint.sh.
# We keep those untouched; GUCCI adds its own /app/gucci directory and runs a
# wrapper entrypoint which prepares the volume + nginx and then chains to the
# official DockerEntrypoint.sh.
COPY gucci /app/gucci
RUN chmod 0755 /app/gucci/entrypoint.sh /app/gucci/healthcheck.sh

# ── GUCCI runtime environment (same contract as the previous image) ──────────
ENV XUI_IN_DOCKER=true \
    XUI_MAIN_FOLDER=/app \
    XUI_ENABLE_FAIL2BAN=true \
    XUI_DB_TYPE=sqlite \
    XUI_DB_DSN="" \
    GUCCI_PUBLIC_PORT=1 \
    XUI_DB_FOLDER=/GUCCI/x-ui \
    XUI_INTERNAL_PORT=2053 \
    XUI_WEB_BASE_PATH=/gucci/ \
    XUI_DATA_ROOT=/GUCCI \
    XUI_FORCE_INITIAL_CREDENTIALS=false

EXPOSE 1 8080

# GUCCI entrypoint sets up the persistent volume, nginx gateway, DB settings,
# and then execs the untouched official /app/DockerEntrypoint.sh.
ENTRYPOINT ["/app/gucci/entrypoint.sh"]
CMD []
